{
  "name": "erid.dev",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "pnpm lint:fix && pnpm format",
    "typecheck": "astro sync && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json && astro check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.1"
  }
}
