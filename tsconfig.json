{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src", "scripts", "tests", "*.config.ts", "*.config.mjs"],
  "exclude": ["dist", "node_modules"]
}
