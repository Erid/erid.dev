---
import WhatsAppContact from '../components/WhatsAppContact.astro'
import Actions from '../components/Actions.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getProfile } from '../lib/content/queries.ts'

const profile = await getProfile()
---

<BaseLayout
  title="About"
  description={`About ${profile.name}: background, working style, and languages.`}
>
  <div class="container page">
    <h1>Hi, I’m {profile.name.split(' ')[0]}.</h1>
    <p class="lead">Based in {profile.location}.</p>
    <div class="prose">
      {profile.biography?.split(/\n{2,}/).map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    {profile.languages.length > 0 && (
      <section aria-labelledby="languages-heading">
        <h2 id="languages-heading">Languages</h2>
        <ul class="plain">
          {profile.languages.map((language) => (
            <li>
              {language.name}
              <span class="muted"> · {language.proficiency}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading">Get in touch</h2>
      <Actions links={profile.links} />
      <WhatsAppContact />
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .lead {
    font-size: var(--step-1);
  }
  section {
    margin-top: var(--space-6);
  }
  h2 {
    font-size: var(--step-1);
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
