---
import ProjectCard from '../../components/ProjectCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getProfile, getProjects } from '../../lib/content/queries.ts'

const profile = await getProfile()
const projects = await getProjects()
---

<BaseLayout
  title="Projects & Case Studies"
  description={`Selected software projects and architectural case studies by ${profile.name}.`}
>
  <div class="container page">
    <h1>Projects & case studies</h1>
    <p class="muted prose">
      Selected engineering work, architectural decisions, and incident write-ups, with links to
      source code where public.
    </p>
    <div class="grid">
      {projects.map(({ id, data }) => (
        <ProjectCard id={id} project={data} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    margin-top: var(--space-5);
  }
</style>
