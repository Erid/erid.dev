---
import type { GetStaticPaths } from 'astro'
import ArrowLeftIcon from '@lucide/astro/icons/arrow-left'
import CodeIcon from '@lucide/astro/icons/code'
import ExternalLinkIcon from '@lucide/astro/icons/external-link'
import CaseStudy from '../../components/CaseStudy.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate, formatRange } from '../../lib/content/dates.ts'
import { getAllExperienceById, getProjects } from '../../lib/content/queries.ts'

// Detail pages exist only for projects with a published case study.
export const getStaticPaths = (async () => {
  const [projects, experienceById] = await Promise.all([getProjects(), getAllExperienceById()])
  return projects
    .filter(({ data }) => data.caseStudy.published)
    .map((entry) => ({
      params: { slug: entry.id },
      props: {
        project: entry.data,
        relatedRole: entry.data.relatedExperience
          ? experienceById[entry.data.relatedExperience]
          : undefined,
      },
    }))
}) satisfies GetStaticPaths

const { project, relatedRole } = Astro.props
---

<BaseLayout title={project.title} description={project.summary}>
  <article class="container page">
    <p class="breadcrumbs">
      <a href="/projects/">
        <ArrowLeftIcon size={16} aria-hidden="true" /> Projects & case studies
      </a>
      {project.relatedExperience && relatedRole && (
        <>
          <span class="muted" aria-hidden="true">
            ·
          </span>
          <a href={`/experience/${project.relatedExperience}/`}>{relatedRole.employer}</a>
        </>
      )}
    </p>
    {relatedRole ? (
      <p class="eyebrow">
        {relatedRole.title} at {relatedRole.employer} ·{' '}
        {formatRange(relatedRole.start, relatedRole.end)}
      </p>
    ) : (
      (project.role || project.date) && (
        <p class="eyebrow">
          {[project.role, project.date ? formatDate(project.date) : undefined]
            .filter(Boolean)
            .join(' · ')}
        </p>
      )
    )}
    <h1>{project.title}</h1>
    <p class="lead prose">{project.summary}</p>
    {project.technologies.length > 0 && (
      <ul class="chips" aria-label="Technologies">
        {project.technologies.map((tech) => (
          <li class="chip chip-quiet">{tech}</li>
        ))}
      </ul>
    )}
    {(project.demoUrl || project.repositoryUrl) && (
      <ul class="links">
        {project.demoUrl && (
          <li>
            <a class="button" href={project.demoUrl} rel="noopener">
              <ExternalLinkIcon size={16} aria-hidden="true" /> Live demo
            </a>
          </li>
        )}
        {project.repositoryUrl && (
          <li>
            <a class="button" href={project.repositoryUrl} rel="noopener">
              <CodeIcon size={16} aria-hidden="true" /> View code
            </a>
          </li>
        )}
      </ul>
    )}
    {project.outcomes.length > 0 && (
      <aside class="card outcomes prose" aria-labelledby="highlights-heading">
        <h2 id="highlights-heading">Key takeaways</h2>
        <ul>
          {project.outcomes.map((outcome) => (
            <li>{outcome}</li>
          ))}
        </ul>
      </aside>
    )}
    <div class="study-body">
      <CaseStudy study={project.caseStudy} />
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  .lead {
    font-size: var(--step-1);
  }
  .chips {
    margin-bottom: var(--space-5);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-5);
    padding: 0;
  }
  .outcomes {
    margin-bottom: var(--space-6);
    background: var(--bg-sunken);
  }
  .outcomes h2 {
    font-size: var(--step-0);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }
  .outcomes ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .outcomes li + li {
    margin-top: var(--space-2);
  }
  .study-body {
    margin-top: var(--space-5);
  }
</style>
