---
import ProjectCard from '../../components/ProjectCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getProfile, getProjects } from '../../lib/content/queries.ts'

// With no published projects this route would be empty; it is not generated at all.
export async function getStaticPaths() {
  const projects = await getProjects()
  return projects.length > 0 ? [{ params: { list: undefined } }] : []
}

const profile = await getProfile()
const projects = await getProjects()
---

<BaseLayout
  title="Projects"
  description={`Selected software projects by ${profile.name}, with code, demos, and case studies where available.`}
>
  <div class="container page">
    <h1>Projects</h1>
    <div class="grid">
      {projects.map(({ id, data }) => (
        <ProjectCard id={id} project={data} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
  }
</style>
