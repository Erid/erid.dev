---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDay } from '../../lib/content/dates.ts'
import { getPosts, getProfile } from '../../lib/content/queries.ts'

// The index exists only once a real article is published.
export const getStaticPaths = (async () =>
  (await getPosts()).length > 0 ? [{ params: { index: undefined } }] : []) satisfies GetStaticPaths

const profile = await getProfile()
const posts = await getPosts()
---

<BaseLayout title="Writing" description={`Articles by ${profile.name} on software engineering.`}>
  <div class="container page">
    <h1>Writing</h1>
    <p class="muted prose">Notes and articles on software architecture and engineering.</p>
    <ul class="posts">
      {posts.map((post) => (
        <li class="card">
          <div class="head">
            <h2>
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </h2>
            {post.data.draft && <span class="chip chip-draft">Draft</span>}
          </div>
          <p class="muted meta">{formatDay(post.data.publishedOn)}</p>
          <p class="summary">{post.data.summary}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .posts {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    max-width: var(--prose-width);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  h2 {
    font-size: var(--step-1);
    margin: 0;
  }
  .meta {
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
  }
  .summary {
    margin: 0;
  }
</style>
