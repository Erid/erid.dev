---
import type { GetStaticPaths } from 'astro'
import ArrowLeftIcon from '@lucide/astro/icons/arrow-left'
import CaseStudy from '../../components/CaseStudy.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatRange, formatRoleDuration } from '../../lib/content/dates.ts'
import { getExperience, getProjects } from '../../lib/content/queries.ts'

// Detail pages exist for roles with a published case study or related project case studies.
export const getStaticPaths = (async () => {
  const [experience, projects] = await Promise.all([getExperience(), getProjects()])
  return experience
    .map((entry) => ({
      entry,
      studies: projects.filter(
        (project) =>
          project.data.relatedExperience === entry.id && project.data.caseStudy.published,
      ),
    }))
    .filter(({ entry, studies }) => entry.data.caseStudy.published || studies.length > 0)
    .map(({ entry, studies }) => ({
      params: { slug: entry.id },
      props: { role: entry.data, studies },
    }))
}) satisfies GetStaticPaths

const { role, studies } = Astro.props
---

<BaseLayout
  title={`${role.title} at ${role.employer}`}
  description={`Case study: ${role.title} at ${role.employer} (${formatRange(role.start, role.end)}).`}
>
  <div class="container page">
    <p>
      <a class="back" href="/experience/">
        <ArrowLeftIcon size={16} aria-hidden="true" /> All experience
      </a>
    </p>
    <p class="eyebrow">
      {formatRange(role.start, role.end)} · {formatRoleDuration(role.start, role.end)}
    </p>
    <h1>{role.title}</h1>
    <p class="employer">{role.employer}</p>
    <p class="prose">{role.contributions.join(' ')}</p>
    {role.caseStudy.published && <CaseStudy study={role.caseStudy} />}
    {studies.map((study) => (
      <article class="study-block">
        <h2>
          <a href={`/projects/${study.id}/`}>{study.data.title}</a>
        </h2>
        <p class="lead prose">{study.data.summary}</p>
        <a href={`/projects/${study.id}/`}>Read case study</a>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-6);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  h1 {
    margin-bottom: var(--space-1);
  }
  .employer {
    margin: 0 0 var(--space-4);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--ink-muted);
  }
  .study-block {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .lead {
    font-size: var(--step-1);
    color: var(--ink-muted);
  }
</style>
