---
import ArrowRightIcon from '@lucide/astro/icons/arrow-right'
import MapPinIcon from '@lucide/astro/icons/map-pin'
import WhatsAppContact from '../components/WhatsAppContact.astro'
import Actions from '../components/Actions.astro'
import ExperienceItem from '../components/ExperienceItem.astro'
import Portrait from '../components/Portrait.astro'
import ProjectCard from '../components/ProjectCard.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { formatDay } from '../lib/content/dates.ts'
import {
  getExperience,
  getPosts,
  getProfile,
  getProjects,
  getSkills,
} from '../lib/content/queries.ts'

const GLANCE_ROLE_COUNT = 3

const [profile, skills, experience, allProjects, posts] = await Promise.all([
  getProfile(),
  getSkills(),
  getExperience(),
  getProjects(),
  getPosts(),
])
const featured = allProjects.filter(({ data }) => data.featured)

const description = `${profile.name}, ${profile.headline}. ${profile.introduction}`
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.headline,
    url: Astro.site?.href,
    sameAs: profile.links.map((link) => link.url),
    knowsAbout: skills.map((skill) => skill.name),
  },
}
---

<BaseLayout
  title={`${profile.name} | ${profile.headline}`}
  description={description}
  isHome
  structuredData={structuredData}
>
  <section class="hero">
    <div class="container">
      <div class="identity">
        {profile.portrait && <Portrait path={profile.portrait} alt={profile.portraitAlt ?? ''} />}
        <div>
          <p class="eyebrow">{profile.headline}</p>
          <h1>{profile.name}</h1>
          <p class="location muted">
            <MapPinIcon size={16} aria-hidden="true" />
            {profile.location}
          </p>
        </div>
      </div>
      <p class="lead">{profile.introduction}</p>
      <ul class="chips stack" aria-label="Core technologies">
        {skills.map((skill) => (
          <li class="chip">{skill.name}</li>
        ))}
      </ul>
      <p class="muted">Open to senior and lead engineering and architecture roles.</p>
      <Actions links={profile.links} />
    </div>
  </section>

  <section class="section container" aria-labelledby="experience-heading">
    <div class="section-header">
      <h2 id="experience-heading">Experience at a glance</h2>
      <a href="/experience/">
        Full work history <ArrowRightIcon size={16} aria-hidden="true" />
      </a>
    </div>
    <div>
      {experience.slice(0, GLANCE_ROLE_COUNT).map(({ id, data }) => (
        <ExperienceItem id={id} role={data} compact />
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section container" aria-labelledby="work-heading">
      <div class="section-header">
        <h2 id="work-heading">Selected work</h2>
        <a href="/projects/">
          All work <ArrowRightIcon size={16} aria-hidden="true" />
        </a>
      </div>
      <div class="grid">
        {featured.map(({ id, data }) => (
          <ProjectCard id={id} project={data} />
        ))}
      </div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="section container" aria-labelledby="writing-heading">
      <div class="section-header">
        <h2 id="writing-heading">Writing</h2>
        <a href="/writing/">
          All articles <ArrowRightIcon size={16} aria-hidden="true" />
        </a>
      </div>
      <ul class="posts">
        {posts.slice(0, 3).map((post) => (
          <li class="card post-item">
            <div class="post-head">
              <h3>
                <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              </h3>
              {post.data.draft && <span class="chip chip-draft">Draft</span>}
            </div>
            <p class="muted post-meta">{formatDay(post.data.publishedOn)}</p>
            <p class="post-summary">{post.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="section container" aria-labelledby="about-heading">
    <div class="card about">
      <h2 id="about-heading">A little more about me</h2>
      <p>
        Based in Costa Rica. Curious about new tools, happiest building things with other people.
      </p>
      <p>
        <a href="/about/">
          About me <ArrowRightIcon size={16} aria-hidden="true" />
        </a>
      </p>
    </div>
  </section>

  <section class="section container" aria-labelledby="contact-heading">
    <h2 id="contact-heading">Get in touch</h2>
    <p class="muted">Open to senior and lead engineering and architecture roles.</p>
    <Actions links={profile.links} />
    <WhatsAppContact />
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-6);
  }
  .identity {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-4);
  }
  h1 {
    margin-bottom: var(--space-1);
  }
  .eyebrow {
    color: var(--accent-strong);
  }
  .location {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
  }
  .lead {
    max-width: var(--prose-width);
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .stack {
    margin-bottom: var(--space-5);
  }
  .grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }
  .posts {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--prose-width);
  }
  .post-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .post-head h3 {
    margin: 0;
    font-size: var(--step-1);
  }
  .post-meta {
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
  }
  .post-summary {
    margin: 0;
  }
  .about {
    background: var(--accent-soft);
    border-color: transparent;
  }
  .about p:last-child {
    margin-bottom: 0;
    font-weight: 600;
  }
</style>
