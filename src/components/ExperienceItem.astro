---
import ArrowRightIcon from '@lucide/astro/icons/arrow-right'
import { formatRange } from '../lib/content/dates.ts'
import { getProjects } from '../lib/content/queries.ts'
import type { Experience } from '../lib/content/schemas.ts'

interface Props {
  id: string
  role: Experience
  /** Compact entries omit the technology labels (used for the homepage overview). */
  compact?: boolean
}

const { id, role, compact = false } = Astro.props

const relatedCaseStudies = (await getProjects()).filter(
  ({ data }) => data.relatedExperience === id && data.caseStudy.published,
)
const detailHref = role.caseStudy.published ? `/experience/${id}/` : undefined
const meta = [role.location, role.employmentType].filter(Boolean).join(' · ')
---

<article id={`role-${id}`} class="role">
  <div class="when">
    <p class="range">{formatRange(role.start, role.end)}</p>
    {meta && <p class="muted meta">{meta}</p>}
  </div>
  <div class="what">
    <h3>{role.title}</h3>
    <p class="employer">{role.employer}</p>
    <p class="description">{role.contributions.slice(0, compact ? 1 : undefined).join(' ')}</p>
    {!compact && role.technologies.length > 0 && (
      <ul class="chips" aria-label="Technologies">
        {role.technologies.map((tech) => (
          <li class="chip chip-quiet">{tech}</li>
        ))}
      </ul>
    )}
    {(detailHref || relatedCaseStudies.length > 0) && (
      <ul class="stories" aria-label={`Case studies for ${role.employer}`}>
        {detailHref && (
          <li>
            <a href={detailHref}>
              Read the case study <ArrowRightIcon size={16} aria-hidden="true" />
              <span class="visually-hidden">
                for {role.title} at {role.employer}
              </span>
            </a>
          </li>
        )}
        {relatedCaseStudies.map((study) => (
          <li>
            <a href={`/projects/${study.id}/`}>
              Case study: {study.data.title} <ArrowRightIcon size={16} aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .role {
    display: grid;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .range {
    margin: 0;
    font-weight: 600;
  }
  .meta {
    margin: 0;
    font-size: var(--step--1);
  }
  h3 {
    margin-bottom: 0;
  }
  .employer {
    margin: 0 0 var(--space-3);
    color: var(--accent-strong);
    font-weight: 600;
  }
  .description {
    margin: 0 0 var(--space-3);
  }

  .stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    font-weight: 600;
  }
  .stories a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
  }
  @media (min-width: 46rem) {
    .role {
      grid-template-columns: 11rem 1fr;
    }
  }
</style>
