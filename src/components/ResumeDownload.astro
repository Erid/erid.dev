---
import ChevronDownIcon from '@lucide/astro/icons/chevron-down'
import FileDownIcon from '@lucide/astro/icons/file-down'
import FileTextIcon from '@lucide/astro/icons/file-text'
import { RESUME_DOCX_PATH, RESUME_PDF_PATH } from '../lib/site.ts'

interface Props {
  /** Compact label ("Résumé (PDF)") for the site header. */
  compact?: boolean
  /** Aligns the format dropdown panel to the start or end edge of the control. */
  align?: 'start' | 'end'
}

const { compact = false, align = 'start' } = Astro.props
---

<div
  class:list={['resume-download', { compact, 'align-end': align === 'end' }]}
  data-resume-download
>
  <a class="primary" href={RESUME_PDF_PATH} download>
    <FileDownIcon size={18} aria-hidden="true" />
    <span>{compact ? 'Résumé (PDF)' : 'Download résumé (PDF)'}</span>
  </a>
  <details class="more">
    <summary aria-label="More résumé formats" title="More résumé formats">
      <ChevronDownIcon class="chevron" size={16} aria-hidden="true" />
    </summary>
    <div class="panel">
      <a class="option" href={RESUME_DOCX_PATH} download>
        <FileTextIcon size={16} aria-hidden="true" />
        <span class="option-body">
          <span class="option-title">Download Word (.docx)</span>
          <span class="option-note">Editable text for ATS & recruiter tools</span>
        </span>
      </a>
      <a class="option" href={RESUME_PDF_PATH} download>
        <FileDownIcon size={16} aria-hidden="true" />
        <span class="option-body">
          <span class="option-title">Download PDF (.pdf)</span>
          <span class="option-note">Selectable text, print-ready layout</span>
        </span>
      </a>
    </div>
  </details>
</div>

<script>
  // Light-dismiss and Escape handling for the native <details> format disclosure.
  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Node)) return
    for (const details of document.querySelectorAll<HTMLDetailsElement>(
      '[data-resume-download] details[open]',
    )) {
      if (
        !details.contains(target) ||
        (target instanceof Element && target.closest('a[download]'))
      ) {
        details.open = false
      }
    }
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    for (const details of document.querySelectorAll<HTMLDetailsElement>(
      '[data-resume-download] details[open]',
    )) {
      details.open = false
      details.querySelector('summary')?.focus()
    }
  })
</script>

<style>
  .resume-download {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    min-height: 2.75rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.15s ease;
  }
  .resume-download.compact {
    min-height: 2.5rem;
  }
  .resume-download:hover {
    box-shadow: var(--shadow-md);
  }
  .primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 0.9rem 0.5rem 1.1rem;
    border-radius: 999px 0 0 999px;
    color: #fff;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .primary:hover {
    color: #fff;
    background: var(--accent-strong);
  }
  .more {
    display: flex;
    align-items: stretch;
  }
  summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: 0.65rem 0.75rem;
    border-left: 1px solid rgb(255 255 255 / 26%);
    border-radius: 0 999px 999px 0;
    color: #fff;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.15s ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  details[open] > summary {
    background: var(--accent-strong);
  }
  .chevron {
    transition: transform 0.15s ease;
  }
  details[open] .chevron {
    transform: rotate(180deg);
  }
  .panel {
    position: absolute;
    top: calc(100% + var(--space-2));
    inset-inline-start: 0;
    z-index: 20;
    width: max-content;
    max-width: calc(100vw - 2rem);
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-md);
    display: grid;
    gap: var(--space-1);
  }
  .align-end .panel {
    inset-inline-start: auto;
    inset-inline-end: 0;
  }
  .option {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.12s ease;
  }
  .option:hover {
    color: var(--ink);
    background: var(--bg-sunken);
  }
  .option :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--accent);
  }
  .option-body {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .option-title {
    font-size: var(--step--1);
    font-weight: 600;
  }
  .option-note {
    font-size: 0.78rem;
    color: var(--ink-muted);
    font-weight: 400;
  }

  @media print {
    .resume-download {
      display: none;
    }
  }
</style>
