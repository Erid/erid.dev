---
import ArrowRight from '@lucide/astro/icons/arrow-right'
import Code from '@lucide/astro/icons/code'
import ExternalLink from '@lucide/astro/icons/external-link'
import { Image } from 'astro:assets'
import { resolveImage } from '../lib/images.ts'
import type { Project } from '../lib/content/schemas.ts'

interface Props {
  id: string
  project: Project
}

const { id, project } = Astro.props
const image = project.images[0]
const caseStudyHref = project.caseStudy.published ? `/projects/${id}/` : undefined
---

<article class="card project">
  {image && (
    <Image src={resolveImage(image.src)} alt={image.alt} width={640} loading="lazy" class="shot" />
  )}
  <h3>{project.title}</h3>
  {project.role && <p class="muted role">{project.role}</p>}
  <p>{project.summary}</p>
  {project.technologies.length > 0 && (
    <ul class="chips" aria-label="Technologies">
      {project.technologies.map((tech) => (
        <li class="chip chip-quiet">{tech}</li>
      ))}
    </ul>
  )}
  <ul class="links">
    {project.demoUrl && (
      <li>
        <a class="button" href={project.demoUrl} rel="noopener">
          <ExternalLink size={16} aria-hidden="true" /> Live demo
          <span class="visually-hidden">of {project.title}</span>
        </a>
      </li>
    )}
    {project.repositoryUrl && (
      <li>
        <a class="button" href={project.repositoryUrl} rel="noopener">
          <Code size={16} aria-hidden="true" /> View code
          <span class="visually-hidden">for {project.title}</span>
        </a>
      </li>
    )}
    {caseStudyHref && (
      <li>
        <a class="button" href={caseStudyHref}>
          <ArrowRight size={16} aria-hidden="true" /> Read case study
          <span class="visually-hidden">for {project.title}</span>
        </a>
      </li>
    )}
  </ul>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
  }
  .shot {
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
    border: 1px solid var(--line);
  }
  h3 {
    margin-bottom: var(--space-1);
  }
  .role {
    margin-bottom: var(--space-3);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: auto 0 0;
    padding: var(--space-4) 0 0;
  }
  .chips {
    margin-bottom: var(--space-3);
  }
</style>
