---
import CodeIcon from '@lucide/astro/icons/code'
import ExternalLinkIcon from '@lucide/astro/icons/external-link'
import FileDownIcon from '@lucide/astro/icons/file-down'
import ContactEmail from './ContactEmail.astro'
import { RESUME_PDF_PATH } from '../lib/site.ts'

interface Props {
  links: { label: string; url: string }[]
}

const { links } = Astro.props
---

<ul class="actions">
  <li>
    <a class="button button-primary" href={RESUME_PDF_PATH} download>
      <FileDownIcon size={18} aria-hidden="true" /> Download résumé (PDF)
    </a>
  </li>
  {links.map((link) => (
    <li>
      <a class="button" href={link.url} rel="me noopener">
        {link.label === 'GitHub' ? (
          <CodeIcon size={18} aria-hidden="true" />
        ) : (
          <ExternalLinkIcon size={18} aria-hidden="true" />
        )}
        {link.label}
      </a>
    </li>
  ))}
  <li>
    <ContactEmail />
  </li>
</ul>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
