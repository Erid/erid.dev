---
import CalendarClockIcon from '@lucide/astro/icons/calendar-clock'
import CodeIcon from '@lucide/astro/icons/code'
import ExternalLinkIcon from '@lucide/astro/icons/external-link'
import ContactEmail from './ContactEmail.astro'
import ResumeDownload from './ResumeDownload.astro'

interface Props {
  links: { label: string; url: string }[]
  schedulingUrl?: string | undefined
  includeResume?: boolean
}

const { links, schedulingUrl, includeResume = true } = Astro.props
const hasContactEmail = Boolean(import.meta.env.CONTACT_EMAIL)
---

<ul class="actions" role="list">
  {includeResume && (
    <li>
      <ResumeDownload />
    </li>
  )}
  {links.map((link) => (
    <li>
      <a class="button" href={link.url} rel="me noopener">
        {link.label === 'GitHub' ? (
          <CodeIcon size={18} aria-hidden="true" />
        ) : (
          <ExternalLinkIcon size={18} aria-hidden="true" />
        )}
        {link.label}
      </a>
    </li>
  ))}
  {schedulingUrl && (
    <li>
      <a
        class="button button-schedule"
        href={schedulingUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <CalendarClockIcon size={18} aria-hidden="true" />
        Schedule a 1:1<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </li>
  )}
  {hasContactEmail && (
    <li>
      <ContactEmail />
    </li>
  )}
</ul>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .button-schedule :global(svg) {
    color: var(--accent);
  }
  .button-schedule:hover {
    border-color: var(--accent);
  }
</style>
