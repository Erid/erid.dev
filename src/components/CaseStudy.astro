---
import { parseProseBlocks } from '../lib/content/prose.ts'
import type { CaseStudy } from '../lib/content/schemas.ts'

interface Props {
  study: CaseStudy
}

const { study } = Astro.props

// Order follows the plan: challenge, contribution, decisions and trade-offs, outcomes.
const sections = [
  { heading: 'The challenge', body: study.challenge },
  { heading: 'My contribution', body: study.contribution },
  { heading: 'Decisions and trade-offs', body: study.decisions },
  { heading: 'Outcomes and lessons', body: study.outcomes },
].filter((section): section is { heading: string; body: string } => Boolean(section.body))
---

<div class="prose">
  {sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      {parseProseBlocks(section.body).map((block) =>
        block.type === 'code' ? (
          <pre
            tabindex="0"
            role="region"
            aria-label={block.language ? `${block.language} code snippet` : 'Code snippet'}
          ><code data-language={block.language || undefined}>{block.code}</code></pre>
        ) : (
          <p>
            {block.segments.map((segment) =>
              segment.type === 'code' ? <code>{segment.value}</code> : segment.value,
            )}
          </p>
        ),
      )}
    </section>
  ))}
</div>

<style>
  section {
    margin-bottom: var(--space-5);
  }
  h2 {
    font-size: var(--step-1);
  }
</style>
