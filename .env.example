# Copy to .env for local work. In CI, provide it as a repository secret or variable.
# The address is never written into the page source in plain text; see src/components/ContactEmail.astro.
CONTACT_EMAIL=


# Required. Bare hostname the site is served from; drives Astro's `site`, SST, the résumé, and
# robots.txt. Use a different value per stage (e.g. staging.example.dev).
SITE_DOMAIN=
